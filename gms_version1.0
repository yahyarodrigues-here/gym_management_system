import sqlite3
from datetime import datetime

class LibrarySystem:
    def __init__(self, db_name="library.db"):
        self.conn = sqlite3.connect(db_name)
        self.cursor = self.conn.cursor()
        self.setup_database()
        self.current_user = None

    def setup_database(self):
        """Creates tables and seeds default data if new."""
        with self.conn:
            self.cursor.execute("""
                CREATE TABLE IF NOT EXISTS users (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    username TEXT UNIQUE NOT NULL,
                    role TEXT NOT NULL CHECK(role IN ('admin', 'member'))
                )
            """)
            self.cursor.execute("""
                CREATE TABLE IF NOT EXISTS books (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    title TEXT NOT NULL,
                    author TEXT NOT NULL,
                    total_copies INTEGER NOT NULL,
                    available_copies INTEGER NOT NULL
                )
            """)
            self.cursor.execute("""
                CREATE TABLE IF NOT EXISTS loans (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER NOT NULL,
                    book_id INTEGER NOT NULL,
                    issue_date TEXT NOT NULL,
                    returned INTEGER DEFAULT 0,
                    FOREIGN KEY(user_id) REFERENCES users(id),
                    FOREIGN KEY(book_id) REFERENCES books(id)
                )
            """)

        # Seed default admin and member if table is empty
        self.cursor.execute("SELECT COUNT(*) FROM users")
        if self.cursor.fetchone()[0] == 0:
            with self.conn:
                self.cursor.execute("INSERT INTO users (username, role) VALUES ('admin', 'admin')")
                self.cursor.execute("INSERT INTO users (username, role) VALUES ('student', 'member')")
                self.cursor.executemany("""
                    INSERT INTO books (title, author, total_copies, available_copies)
                    VALUES (?, ?, ?, ?)
                """, [
                    ("1984", "George Orwell", 3, 3),
                    ("To Kill a Mockingbird", "Harper Lee", 2, 2),
                    ("The Great Gatsby", "F. Scott Fitzgerald", 1, 1)
                ])

    def login(self, username):
        self.cursor.execute("SELECT id, username, role FROM users WHERE LOWER(username) = LOWER(?)", (username,))
        user = self.cursor.fetchone()
        if user:
            self.current_user = {"id": user[0], "username": user[1], "role": user[2]}
            print(f"\nLogged in as {user[1]} ({user[2].capitalize()})")
            return True
        print("\nUser not found.")
        return False

    def display_books(self):
        self.cursor.execute("SELECT id, title, author, available_copies, total_copies FROM books")
        books = self.cursor.fetchall()
        print("\n" + "=" * 65)
        print(f"{'ID':<4} | {'Title':<25} | {'Author':<20} | Stock")
        print("=" * 65)
        for b in books:
            print(f"{b[0]:<4} | {b[1]:<25} | {b[2]:<20} | {b[3]}/{b[4]}")
        print("=" * 65)

    def borrow_book(self, book_id):
        self.cursor.execute("SELECT available_copies, title FROM books WHERE id = ?", (book_id,))
        book = self.cursor.fetchone()
        
        if not book:
            print("\nInvalid Book ID.")
            return
        if book[0] <= 0:
            print(f"\nSorry, '{book[1]}' is currently out of stock.")
            return

        now = datetime.now().strftime("%Y-%m-%d %H:%M")
        with self.conn:
            self.cursor.execute("UPDATE books SET available_copies = available_copies - 1 WHERE id = ?", (book_id,))
            self.cursor.execute("INSERT INTO loans (user_id, book_id, issue_date) VALUES (?, ?, ?)",
                                (self.current_user["id"], book_id, now))
        print(f"\nSuccess: You borrowed '{book[1]}'.")

    def return_book(self, book_id):
        self.cursor.execute("""
            SELECT id FROM loans 
            WHERE user_id = ? AND book_id = ? AND returned = 0
        """, (self.current_user["id"], book_id))
        loan = self.cursor.fetchone()

        if not loan:
            print("\nNo active record found for this book under your account.")
            return

        with self.conn:
            self.cursor.execute("UPDATE loans SET returned = 1 WHERE id = ?", (loan[0],))
            self.cursor.execute("UPDATE books SET available_copies = available_copies + 1 WHERE id = ?", (book_id,))
        print("\nSuccess: Book returned successfully.")

    def view_my_loans(self):
        self.cursor.execute("""
            SELECT b.title, l.issue_date 
            FROM loans l 
            JOIN books b ON l.book_id = b.id 
            WHERE l.user_id = ? AND l.returned = 0
        """, (self.current_user["id"],))
        loans = self.cursor.fetchall()
        print(f"\n--- Active Borrowed Books for {self.current_user['username']} ---")
        if not loans:
            print("No active loans.")
            return
        for book_title, issue_date in loans:
            print(f"- {book_title} (Borrowed on: {issue_date})")

    # --- Admin Functions ---
    def add_book(self, title, author, copies):
        with self.conn:
            self.cursor.execute("""
                INSERT INTO books (title, author, total_copies, available_copies)
                VALUES (?, ?, ?, ?)
            """, (title, author, copies, copies))
        print(f"\nAdmin Action: Added '{title}' with {copies} copies.")

    def register_user(self, username, role):
        try:
            with self.conn:
                self.cursor.execute("INSERT INTO users (username, role) VALUES (?, ?)", (username, role))
            print(f"\nAdmin Action: Created user '{username}' as {role}.")
        except sqlite3.IntegrityError:
            print("\nError: Username already exists.")


def main():
    system = LibrarySystem()
    
    print("=== Welcome to the Enterprise Library System ===")
    print("Default accounts created: 'admin' (Admin), 'student' (Member)")
    
    while True:
        if not system.current_user:
            user_input = input("\nEnter username to login (or type 'exit'): ").strip()
            if user_input.lower() == 'exit':
                break
            system.login(user_input)
            continue

        role = system.current_user["role"]
        print(f"\n--- Main Menu [{system.current_user['username'].upper()}] ---")
        print("1. View Book Catalog")
        print("2. Borrow a Book")
        print("3. Return a Book")
        print("4. View My Borrowed Books")
        
        if role == "admin":
            print("5. [Admin] Add New Book Stock")
            print("6. [Admin] Register New User")
            
        print("7. Logout")

        choice = input("\nSelect option: ").strip()

        if choice == "1":
            system.display_books()
        elif choice == "2":
            try:
                b_id = int(input("Enter Book ID to borrow: "))
                system.borrow_book(b_id)
            except ValueError:
                print("\nPlease enter a valid integer ID.")
        elif choice == "3":
            try:
                b_id = int(input("Enter Book ID to return: "))
                system.return_book(b_id)
            except ValueError:
                print("\nPlease enter a valid integer ID.")
        elif choice == "4":
            system.view_my_loans()
        elif choice == "5" and role == "admin":
            t = input("Title: ").strip()
            a = input("Author: ").strip()
            try:
                c = int(input("Copy Count: "))
                if t and a and c > 0:
                    system.add_book(t, a, c)
            except ValueError:
                print("\nInvalid count.")
        elif choice == "6" and role == "admin":
            u = input("New Username: ").strip()
            r = input("Role (admin/member): ").strip().lower()
            if u and r in ['admin', 'member']:
                system.register_user(u, r)
        elif choice == "7":
            system.current_user = None
            print("\nLogged out successfully.")


if __name__ == "__main__":
    main()
